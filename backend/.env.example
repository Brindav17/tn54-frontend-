# Defaults to a local SQLite file if unset. Point this at Postgres for
# anything beyond local dev, e.g.:
# postgresql://user:password@localhost:5432/thyroscan
DATABASE_URL=

# Used to sign JWT access tokens. Generate a real random value, e.g.:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# OAuth 2.0 Client ID from Google Cloud Console -- required for /auth/google.
GOOGLE_CLIENT_ID=

ALLOWED_ORIGIN=http://localhost:5173

# Optional -- overrides the default backend/weights/*.pth lookup.
MODEL_PATH=
